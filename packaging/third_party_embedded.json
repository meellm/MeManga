{
  "about": [
    "Third-party code compiled into a bundled library whose own package",
    "ships no attribution for it. When a desktop bundle contains one of an",
    "entry's 'files' (case-insensitive name patterns), the notices list each",
    "of its components with the license texts from packaging/licenses/.",
    "The texts are recorded for one Qt release ('qt'); a bundle with another",
    "Qt version stops the build until they are refreshed from that release.",
    "Qt PDF: the components are the ones the Qt PDF licensing page lists",
    "('listed_at'); the texts are the files each component's README.chromium",
    "names as 'License File', at the qtwebengine-chromium commit the",
    "qtwebengine tag pins as src/3rdparty ('source')."
  ],
  "libraries": [
    {
      "library": "Qt PDF",
      "files": ["libqt6pdf.so*", "qt6pdf.dll", "qtpdf"],
      "qt": "6.11.1",
      "listed_at": "https://doc.qt.io/qt-6.11/qtpdf-licensing.html",
      "pinned_by": "https://github.com/qt/qtwebengine/tree/v6.11.1/src",
      "source": "https://github.com/qt/qtwebengine-chromium/blob/58c11ad487f8a237cf0ac71cc3e818b52db150df/chromium",
      "components": [
        {
          "name": "PDFium",
          "version": "",
          "license": "BSD-3-Clause, Apache-2.0 (listed by Qt as BSD)",
          "homepage": "https://pdfium.googlesource.com/pdfium/",
          "source_files": ["third_party/pdfium/LICENSE"],
          "license_files": ["qtpdf/PDFIUM-LICENSE.txt"]
        },
        {
          "name": "The Chromium Project",
          "version": "",
          "license": "BSD-3-Clause",
          "homepage": "https://www.chromium.org/",
          "source_files": ["LICENSE"],
          "license_files": ["CHROMIUM-LICENSE.txt"]
        },
        {
          "name": "Abseil",
          "version": "56945519b5d1",
          "license": "Apache-2.0",
          "homepage": "https://github.com/abseil/abseil-cpp",
          "source_files": ["third_party/abseil-cpp/LICENSE"],
          "license_files": ["qtpdf/ABSEIL-LICENSE.txt"]
        },
        {
          "name": "FreeType",
          "version": "2.13.3-307-g27c1cb10a",
          "license": "FTL",
          "homepage": "https://freetype.org/",
          "source_files": ["third_party/freetype/src/docs/FTL.TXT"],
          "license_files": ["qtpdf/FREETYPE-FTL.txt"]
        },
        {
          "name": "fast_float",
          "version": "7.0.0",
          "license": "MIT",
          "homepage": "https://github.com/fastfloat/fast_float",
          "source_files": ["third_party/fast_float/src/LICENSE-MIT"],
          "license_files": ["qtpdf/FAST-FLOAT-LICENSE-MIT.txt"]
        },
        {
          "name": "ICU",
          "version": "74.2",
          "license": "Unicode-3.0 (listed by Qt as MIT)",
          "homepage": "https://github.com/unicode-org/icu",
          "source_files": ["third_party/icu/LICENSE"],
          "license_files": ["qtpdf/ICU-LICENSE.txt"]
        },
        {
          "name": "libjpeg-turbo",
          "version": "3.1.0",
          "license": "IJG, BSD-3-Clause, Zlib",
          "homepage": "https://libjpeg-turbo.org/",
          "source_files": ["third_party/libjpeg_turbo/LICENSE.md",
                           "third_party/libjpeg_turbo/README.ijg"],
          "license_files": ["qtpdf/LIBJPEG-TURBO-LICENSE.md",
                            "qtpdf/LIBJPEG-TURBO-README.ijg"]
        },
        {
          "name": "libpng",
          "version": "1.6.58",
          "license": "Libpng-2.0, Libpng",
          "homepage": "http://libpng.org/",
          "source_files": ["third_party/libpng/LICENSE"],
          "license_files": ["qtpdf/LIBPNG-LICENSE.txt"]
        },
        {
          "name": "zlib",
          "version": "1.3.1",
          "license": "Zlib",
          "homepage": "https://zlib.net/",
          "source_files": ["third_party/zlib/LICENSE"],
          "license_files": ["qtpdf/ZLIB-LICENSE.txt"]
        }
      ]
    }
  ]
}
